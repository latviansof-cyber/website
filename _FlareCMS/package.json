{
  "name": "flarecms",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tsndr/cloudflare-worker-jwt": "^3.2.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "i18next": "^26.4.1",
    "luxon": "^3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev\" \"npm run api\"",
    "api": "tsx src/api/mock-server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "build-functions": "wrangler pages functions build --outdir .wrangler/worker --minify && mv .wrangler/worker/index.js dist/_worker.js",
    "build-all": "npm run build && npm run build-functions",
    "deploy": "./deploy.sh",
    "db:migrate": "wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "types:cloudflare": "npx wrangler@4.114.0 types -c wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.0.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.17.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
