{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latviansof-flare",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "latviansof-flare",
      "database_id": "48860e0b-f07d-4491-bb7c-26aefdb7e65b",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "latviansof-flare-media"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}

