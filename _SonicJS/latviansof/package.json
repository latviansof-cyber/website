{
  "name": "latviansof",
  "version": "0.1.0",
  "private": true,
  "description": "Latvians of Darwin production website (SonicJS CMS on Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc",
    "deploy": "./deploy.sh",
    "deploy:worker": "wrangler deploy -c wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.jsonc",
    "db:reset": "sonicjs-db-reset",
    "db:studio": "drizzle-kit studio",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "update": "npm install @sonicjs-cms/core@latest --save",
    "update:beta": "npm install @sonicjs-cms/core@beta --save",
    "update:plugin": "tsx scripts/update-plugin.ts",
    "seed": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@sonicjs-cms/core": "file:../darwin-sonicjs/packages/core"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.7",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "wrangler": "^4.52.1",
    "zod": "^4.1.13"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "better-auth": "1.6.23",
    "@better-auth/drizzle-adapter": "1.6.23"
  }
}
