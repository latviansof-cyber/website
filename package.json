{
  "name": "latvian-website",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deploy:app": "cross-env CI=true pnpm run build:next && node scripts/clean-vercel-og.mjs && opennextjs-cloudflare build --skipNextBuild --env=$CLOUDFLARE_ENV && wrangler deploy --minify --env=$CLOUDFLARE_ENV",
    "generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "deploy": "pnpm run deploy:database && pnpm run deploy:app",
    "deploy:sh": "./deploy.sh",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "build": "cross-env PAYLOAD_BUILD=true NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "build:next": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "ii": "pnpm install --ignore-workspace",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation jest --config jest.config.ts",
    "test": "pnpm run test:unit && pnpm run test:int && pnpm run test:e2e",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env=$CLOUDFLARE_ENV",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "genog-local": "node scripts/run-og-images-local.mjs",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed.ts",
    "deploy:database": "cross-env CI=true NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --env=$CLOUDFLARE_ENV --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@payloadcms/db-d1-sqlite": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-r2": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "assert": "^2.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "graphql": "^17.0.2",
    "next": "16.2.12",
    "path-browserify": "^1.0.1",
    "payload": "3.86.0",
    "quill": "^2.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.12",
    "fast-xml-parser": "^5.10.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "30.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10",
    "wrangler": "~4.114.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^10 || ^11"
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  },
  "packageManager": "pnpm@11.17.0"
}
