{
    "name":  "",
    "version":  "1.0.0",
    "description":  "A blank template to get started with Payload 3.0",
    "license":  "MIT",
    "type":  "module",
    "scripts":  {
                    "generate:types":  "pnpm run generate:types:cloudflare \u0026\u0026 pnpm run generate:types:payload",
                    "generate:types:payload":  "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
                    "start":  "cross-env NODE_OPTIONS=--no-deprecation next start",
                    "devsafe":  "rm -rf .next \u0026\u0026 rm -rf .open-next \u0026\u0026 cross-env NODE_OPTIONS=--no-deprecation next dev",
                    "generate:importmap":  "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
                    "deploy":  "pnpm run deploy:database \u0026\u0026 pnpm run deploy:app",
                    "payload":  "cross-env NODE_OPTIONS=--no-deprecation payload",
                    "build":  "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
                    "deploy:app":  "opennextjs-cloudflare build --env=$CLOUDFLARE_ENV \u0026\u0026 opennextjs-cloudflare deploy --env=$CLOUDFLARE_ENV",
                    "lint":  "cross-env NODE_OPTIONS=--no-deprecation next lint",
                    "ii":  "pnpm install --ignore-workspace",
                    "test:int":  "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
                    "dev":  "cross-env NODE_OPTIONS=--no-deprecation next dev",
                    "test:unit":  "cross-env NODE_OPTIONS=--no-deprecation jest --config jest.config.ts",
                    "test":  "pnpm run test:unit \u0026\u0026 pnpm run test:int \u0026\u0026 pnpm run test:e2e",
                    "preview":  "opennextjs-cloudflare build \u0026\u0026 opennextjs-cloudflare preview --env=$CLOUDFLARE_ENV",
                    "test:e2e":  "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
                    "generate:types:cloudflare":  "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
                    "deploy:database":  "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate \u0026\u0026 wrangler d1 execute D1 --command \u0027PRAGMA optimize\u0027 --env=$CLOUDFLARE_ENV --remote"
                },
    "dependencies":  {
                         "react":  "19.2.1",
                         "@payloadcms/db-d1-sqlite":  "3.85.0",
                         "@payloadcms/richtext-lexical":  "3.85.0",
                         "graphql":  "^16.8.1",
                         "@payloadcms/storage-r2":  "3.85.0",
                         "react-dom":  "19.2.1",
                         "zod":  "^3.23.8",
                         "next":  "15.4.11",
                         "@opennextjs/cloudflare":  "^1.11.0",
                         "@payloadcms/next":  "3.85.0",
                         "cross-env":  "^7.0.3",
                         "payload":  "3.85.0",
                         "dotenv":  "16.4.7",
                         "@payloadcms/ui":  "3.85.0"
                     },
    "devDependencies":  {
                            "vitest":  "4.0.18",
                            "@types/jest":  "^29.5.12",
                            "eslint":  "^9.16.0",
                            "@eslint/eslintrc":  "^3.2.0",
                            "typescript":  "5.7.3",
                            "jest-environment-jsdom":  "^29.7.0",
                            "eslint-config-next":  "15.4.11",
                            "@testing-library/jest-dom":  "^6.4.2",
                            "ts-jest":  "^29.1.2",
                            "prettier":  "^3.4.2",
                            "vite-tsconfig-paths":  "6.0.5",
                            "@testing-library/user-event":  "^14.5.2",
                            "@vitejs/plugin-react":  "4.5.2",
                            "jest":  "^29.7.0",
                            "tsx":  "4.22.4",
                            "wrangler":  "~4.61.1",
                            "@types/node":  "22.19.9",
                            "@playwright/test":  "1.58.2",
                            "@testing-library/react":  "16.3.0",
                            "jsdom":  "28.0.0",
                            "@types/react":  "19.2.9",
                            "@types/react-dom":  "19.2.3"
                        },
    "engines":  {
                    "node":  "^18.20.2 || \u003e=20.9.0",
                    "pnpm":  "^9 || ^10"
                },
    "pnpm":  {
                 "onlyBuiltDependencies":  [
                                               "sharp",
                                               "esbuild",
                                               "unrs-resolver"
                                           ]
             },
    "cloudflare":  {
                       "bindings":  {
                                        "PAYLOAD_SECRET":  {
                                                               "description":  "Generate a random string using `openssl rand -hex 32`"
                                                           }
                                    }
                   }
}
